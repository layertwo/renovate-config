{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["smithy-build.json", "**/smithy-build.json"],
      "matchStrings": [
        "\"(?<packageName>software\\.amazon\\.smithy:[^:]+):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "maven",
      "versioningTemplate": "gradle"
    }
  ]
}